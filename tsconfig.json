{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // rig-c's `./core` entry is TypeScript source that imports its siblings
    // with their `.ts` extension; typechecking it needs this (and it is legal
    // because nothing here emits JavaScript through tsc — see build-lib.mjs).
    "allowImportingTsExtensions": true
  },
  "include": ["src", "tests", "bench", "playwright.config.ts"],
  // The optional load benchmark has an isolated official-runtime install.
  // Typecheck it explicitly with bench/tsconfig.load.json after preparing it.
  "exclude": ["bench/load.ts", "bench/load-base.generated.ts", "bench/base.generated", "bench/oracle"]
}
